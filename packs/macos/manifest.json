{
  "schema": 1,
  "id": "com.mino.macos",
  "name": {
    "en": "macOS",
    "ar": "ماك أو إس"
  },
  "author": "mino-win-style",
  "description": {
    "en": "A quiet, dark desktop in the spirit of macOS: system blue accent, transparency on, the taskbar centred and out of the way, and the widgets and clutter turned off.",
    "ar": "سطح مكتب داكن وهادئ بروح ماك أو إس: أزرق النظام، وشفافية مفعّلة، وشريط مهام في الوسط يختفي عند عدم الحاجة، مع إطفاء الأدوات والزحام."
  },
  "requires": {
    "min_build": 22000,
    "max_build": null
  },
  "settings": {
    "appearance.dark_mode": true,
    "appearance.accent_color": "#0A84FF",
    "appearance.transparency": true,
    "appearance.accent_on_titlebars": false,
    "appearance.accent_on_start_taskbar": false,

    "desktop.wallpaper": "assets/wallpaper.png",
    "desktop.wallpaper_fit": "fill",

    "taskbar.alignment": "center",
    "taskbar.auto_hide": true,
    "taskbar.widgets": false,
    "taskbar.search": "hidden",
    "taskbar.task_view": false,
    "taskbar.seconds_in_clock": false,

    "start.layout": "more_pins",
    "start.recently_added_apps": false,
    "start.recommended_files": false,

    "explorer.compact_view": false,
    "explorer.launch_to": "home"
  }
}
